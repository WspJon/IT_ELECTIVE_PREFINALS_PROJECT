@{
    ViewData["Title"] = "Home Dashboard";
}

<div class="container mt-4">
    <div class="p-5 mb-4 bg-white rounded-4 shadow-sm border text-center">
        <h1 class="display-5 fw-bold text-primary mb-4">🎫 IT HelpDesk Management System</h1>

        <hr class="my-4" />

        <h5 class="text-muted mb-4 fw-semibold">Quick Navigation Hub</h5>
        <div class="row g-3 justify-content-center">
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-primary btn-lg w-100 py-3 shadow-sm">
                    🎫 <strong>Tickets</strong>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-secondary btn-lg w-100 py-3 shadow-sm">
                    🏢 <strong>Departments</strong>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-success btn-lg w-100 py-3 shadow-sm">
                    👥 <strong>Employees</strong>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Teams" asp-action="Index" class="btn btn-outline-info btn-lg w-100 py-3 shadow-sm">
                    🛡️ <strong>Teams</strong>
                </a>
            </div>
        </div>

        <div class="row g-3 justify-content-center mt-2">
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-dark btn-lg w-100 py-3 shadow-sm">
                    💼 <strong>Customers</strong>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <a asp-controller="Reports" asp-action="EmployeeWorkload" class="btn btn-warning btn-lg w-100 py-3 shadow-sm text-dark">
                    📊 <strong>Analytics & Reports</strong>
                </a>
            </div>
        </div>
    </div>
</div>