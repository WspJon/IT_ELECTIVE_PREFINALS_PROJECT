@model WspJon.IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container my-4">
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Ticket #@Model.Id: @Model.Title</h3>
            <span class="badge bg-light text-dark">@Model.Status</span>
        </div>
        <div class="card-body">
            <p><strong>Description:</strong> @Model.Description</p>
            <p><strong>Created Date:</strong> @Model.CreatedAt.ToString("f")</p>
            <p><strong>Customer:</strong> @(Model.Customer != null ? Model.Customer.Name : "N/A")</p>
        </div>
    </div>

    <!-- Task M3.3: Comments Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Comments History</h4>
        </div>
        <div class="card-body">
            @if (Model.TicketComments != null && Model.TicketComments.Any())
            {
                <div class="list-group">
                    @foreach (var comment in Model.TicketComments.OrderByDescending(c => c.CreatedAt))
                    {
                        <div class="list-group-item list-group-item-action flex-column align-items-start mb-2 rounded border">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <h6 class="mb-1 fw-bold text-primary">
                                    @(comment.Employee != null ? comment.Employee.Name : "Author")
                                    @if (comment.IsInternal)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Internal Note</span>
                                    }
                                </h6>
                                <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")</small>
                            </div>
                            <p class="mb-1 mt-2 text-dark">@comment.CommentText</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">No comments found for this ticket.</div>
            }
        </div>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>