@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container mt-4">
    <h2>💼 Customer Accounts</h2>
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Contact Name</th>
                <th>Company</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cust in Model)
            {
                <tr>
                    <td><strong>@cust.ContactName</strong></td>
                    <td>@(cust.CompanyName ?? "Individual")</td>
                    <td>@cust.Email</td>
                    <td>@(cust.Phone ?? "-")</td>
                    <td>
                        @if (cust.IsActive == 1)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>