@model IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details - #" + Model.Id;
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Ticket #@Model.Id: @Model.Subject</h4>
            <div>
                <span class="badge bg-warning text-dark me-2">Priority: @(Model.Priority?.Name ?? "Normal")</span>
                <span class="badge bg-primary">Status: @(Model.Status?.Name ?? "Open")</span>
            </div>
        </div>
        <div class="card-body">
            <h5>Description:</h5>
            <p class="lead bg-light p-3 rounded border">@(Model.Description ?? "No description provided.")</p>

            <hr />
            <div class="row">
                <div class="col-md-4">
                    <h6 class="text-primary">👤 Customer Information</h6>
                    <p>
                        <strong>Contact:</strong> @(Model.Customer?.ContactName ?? "-")<br />
                        <strong>Company:</strong> @(Model.Customer?.CompanyName ?? "Individual")<br />
                        <strong>Email:</strong> @(Model.Customer?.Email ?? "-")<br />
                        <strong>Phone:</strong> @(Model.Customer?.Phone ?? "-")
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-primary">📂 Ticket Details</h6>
                    <p>
                        <strong>Category:</strong> @(Model.Category?.Name ?? "General")<br />
                        <strong>Created Date:</strong> @(Model.CreatedAt ?? "-")<br />
                        <strong>Resolved Date:</strong> @(Model.ResolvedAt ?? "Not yet resolved")
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-primary">🏷️ Tags</h6>
                    @if (Model.TicketTags != null && Model.TicketTags.Any())
                    {
                        <div>
                            @foreach (var tagJoin in Model.TicketTags)
                            {
                                <span class="badge bg-info text-dark me-1" style="font-size: 0.9rem;">
                                    @(tagJoin.Tag?.Name)
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No tags attached.</p>
                    }
                </div>
            </div>

            <hr />
            <div class="row">
                <div class="col-md-12">
                    <h6 class="text-primary">👥 Assigned Technicians</h6>
                    @if (Model.TicketAssignments != null && Model.TicketAssignments.Any())
                    {
                        <ul class="list-group">
                            @foreach (var assign in Model.TicketAssignments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>
                                        <strong>@(assign.Employee?.FirstName) @(assign.Employee?.LastName)</strong>
                                        <small class="text-muted">(@(assign.Employee?.Email))</small>
                                    </span>
                                    @if (assign.IsPrimary == 1)
                                    {
                                        <span class="badge bg-success">Primary Technician</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No technicians currently assigned.</p>
                    }
                </div>
            </div>

            <hr />
            <div class="row">
                <div class="col-md-12">
                    <h6 class="text-primary">💬 Comments History</h6>
                    @if (Model.TicketComments != null && Model.TicketComments.Any())
                    {
                        <div class="list-group">
                            @foreach (var comment in Model.TicketComments.OrderBy(c => c.CreatedAt))
                            {
                                <div class="list-group-item list-group-item-action flex-column align-items-start mb-2 rounded border">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1 text-primary">
                                            🧑‍💼 @(comment.Employee?.FirstName) @(comment.Employee?.LastName)
                                            @if (comment.IsInternal == 1)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">Internal Only</span>
                                            }
                                        </h6>
                                        <small class="text-muted">@comment.CreatedAt</small>
                                    </div>
                                    <p class="mb-1 mt-2">@comment.Comment</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No comments recorded.</p>
                    }
                </div>
            </div>

            <hr />
            <div class="row">
                <div class="col-md-12">
                    <h6 class="text-primary">📎 File Attachments</h6>
                    @if (Model.TicketAttachments != null && Model.TicketAttachments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mt-2">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>File Name</th>
                                        <th>Content Type</th>
                                        <th>File Size</th>
                                        <th>Uploaded Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in Model.TicketAttachments)
                                    {
                                        <tr>
                                            <td>📄 <strong>@file.FileName</strong></td>
                                            <td><code>@file.ContentType</code></td>
                                            <td>@(file.FileSize / 1024) KB</td>
                                            <td><small class="text-muted">@file.UploadedAt</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No attachments uploaded.</p>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-secondary">← Back to Tickets List</a>
        </div>
    </div>
</div>