@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket>

@{
    ViewData["Title"] = "Unassigned Tickets";
}

<div class="container mt-4">
    <h2>⚠️ Unassigned Tickets Queue</h2>
    <p class="text-muted">Tickets that currently have no active technician assigned.</p>
    <table class="table table-bordered table-hover mt-3">
        <thead class="table-danger">
            <tr>
                <th>#</th>
                <th>Subject</th>
                <th>Customer</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>#@item.Id</strong></td>
                    <td>@item.Subject</td>
                    <td>@(item.Customer?.ContactName ?? "-")</td>
                    <td>@(item.Category?.Name ?? "General")</td>
                    <td><span class="badge bg-warning text-dark">@(item.Priority?.Name)</span></td>
                    <td><span class="badge bg-danger">@(item.Status?.Name)</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>