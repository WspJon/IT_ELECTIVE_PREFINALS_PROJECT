@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.PrimaryAssigneeViewModel>

@{
    ViewData["Title"] = "Primary Assignees";
}

<div class="container mt-4">
    <h2>⭐ Primary Assignee per Ticket</h2>
    <p class="text-muted">Shows designated lead technician or 'Unassigned'.</p>
    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Subject</th>
                <th>Customer</th>
                <th>Status</th>
                <th>Primary Technician</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>#@item.TicketId</strong></td>
                    <td>@item.Title</td>
                    <td>@item.CustomerName</td>
                    <td><span class="badge bg-secondary">@item.StatusName</span></td>
                    <td>
                        @if (item.PrimaryTechnician == "Unassigned")
                        {
                            <span class="badge bg-danger">Unassigned</span>
                        }
                        else
                        {
                            <span class="badge bg-success">⭐ @item.PrimaryTechnician</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>