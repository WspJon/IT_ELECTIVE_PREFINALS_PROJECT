@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket>

@{
    ViewData["Title"] = "Multiple-Assignee Tickets";
}

<div class="container mt-4">
    <h2>👥 Tickets with Multiple Assignees</h2>
    <p class="text-muted">Tickets handled collaboratively by 2 or more technicians.</p>
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Subject</th>
                <th>Customer</th>
                <th>Assigned Technicians</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><strong>#@t.Id</strong></td>
                    <td>@t.Subject</td>
                    <td>@(t.Customer?.ContactName ?? "-")</td>
                    <td>
                        @foreach (var assign in t.TicketAssignments)
                        {
                            <span class="badge bg-secondary me-1">
                                @(assign.Employee?.FirstName) @(assign.Employee?.LastName)
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>